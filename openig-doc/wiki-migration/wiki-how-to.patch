-                "condition" : "${response.headers['Content-Type'][0].split(';')[0] != request.headers['Accept'][0].split(';')[0] }",
-                "handler": {
-                  "type": "StaticResponseHandler",
-                  "config": {
-                    "status": 406,
-                    "reason": "Not Acceptable",
-                    "headers": {
-                      "Content-Type": [ "application/json" ]
-                    },
-                    "entity": "{ \"error\": \"Not Acceptable\"}"
-                  }
-                }
-              }
-            ]
-...            
